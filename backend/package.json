{
  "name": "cymor-coursechecker-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CYMOR KUCCPS CourseChecker API: scoring, eligibility, PDF import and report generation",
  "license": "UNLICENSED",
  "engines": { "node": ">=20.11" },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "import:pdfs": "tsx scripts/import-pdfs.ts",
    "validate:dataset": "tsx scripts/validate-dataset.ts",
    "activate:dataset": "tsx scripts/activate-dataset.ts",
    "create:admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
