# Copy to .env (never commit .env). All values below are placeholders.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (create a database user with readWrite on one database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cymor_coursechecker
# Comma-separated browser origins allowed to call the API (your Vercel URL)
CORS_ORIGINS=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
REPORT_TTL_DAYS=30
PUBLIC_RATE_LIMIT_PER_MIN=30
PDF_RATE_LIMIT_PER_10MIN=10
ADMIN_RATE_LIMIT_PER_15MIN=20
REQUEST_TIMEOUT_MS=60000
UPLOAD_MAX_MB=25
SITE_NAME=CYMOR KUCCPS CourseChecker
SUPPORT_EMAIL=simion@karimique.com
SUPPORT_WHATSAPP=0113821327
# Public URL of the FRONTEND (used in emails)
PUBLIC_SITE_URL=https://your-site.vercel.app

# --- Pricing ---
PRICE_KES=149
PAYMENT_RATE_LIMIT_PER_10MIN=8

# --- M-Pesa Daraja (STK push). PLACEHOLDERS ONLY: put the real values in the Render dashboard, never in git. ---
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379                 # paybill or till (store) number
MPESA_PASSKEY=your-daraja-passkey
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=                         # optional; defaults to MPESA_SHORTCODE (for Buy Goods use the Till number)
MPESA_CALLBACK_BASE_URL=https://your-api.onrender.com
# 24+ random chars; becomes part of the callback URL path
MPESA_CALLBACK_SECRET=

# --- Email (Brevo HTTPS API; Render free tier blocks SMTP) ---
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=reports@your-verified-domain.example   # a sender verified in Brevo
EMAIL_FROM_NAME=CYMOR CourseChecker

# OPTIONAL one-time seeding on hosts without a shell (Render free tier). 32+ random chars.
# Set it, call POST /api/v1/admin/seed once with header X-Seed-Key, then DELETE this variable.
SEED_KEY=

# OPTIONAL admin bootstrap (no shell on Render free). Creates this admin at startup if missing; then DELETE ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
