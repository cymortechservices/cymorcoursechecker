# Copy to .env (never commit .env). All values below are placeholders.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (create a database user with readWrite on one database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cymor_coursechecker
# Comma-separated browser origins allowed to call the API (your Vercel URL)
CORS_ORIGINS=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
REPORT_TTL_DAYS=30
PUBLIC_RATE_LIMIT_PER_MIN=30
PDF_RATE_LIMIT_PER_10MIN=10
ADMIN_RATE_LIMIT_PER_15MIN=20
REQUEST_TIMEOUT_MS=60000
UPLOAD_MAX_MB=25
SITE_NAME=CYMOR KUCCPS CourseChecker
# Optional contact shown in the PDF (leave empty if none)
SUPPORT_EMAIL=
